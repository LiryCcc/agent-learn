{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["VITE_BASE_PATH", "VITE_USE_HASH_ROUTING", "CI", "GITHUB_SHA", "GITHUB_REF_NAME", "GITHUB_HEAD_REF"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CI"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "preview": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}
