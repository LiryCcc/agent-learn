{
  "extends": "@liry-a/tsconfig",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "scripts", "eslint.config.ts", "tsdown.config.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
