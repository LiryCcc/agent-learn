{
  "name": "@liry-a/monorepo",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm check-runtime && pnpm check-spell && pnpm check-scripts && pnpm check-code && pnpm check-packages && pnpm check-layers",
    "check-code": "node scripts/check-source-conventions.ts",
    "check-layers": "node scripts/check-layer-dependencies.ts",
    "check-packages": "node scripts/check-package-boundaries.ts",
    "check-runtime": "node scripts/check-runtime.ts",
    "check-scripts": "tsc -p tsconfig.json",
    "check-spell": "cspell . --cache",
    "dev": "turbo run dev --filter=@liry-a/agent-fe",
    "format": "prettier . --write --cache",
    "graph": "turbo run build --graph",
    "lint": "pnpm check && turbo run typecheck lint",
    "lint-packages": "turbo run lint --filter=@liry-a/agent-core --filter=@liry-a/agent-fe",
    "prepare": "pnpm build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@liry-a/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cspell": "^10.3.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-toml": "^2.0.6",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.17.0"
}
