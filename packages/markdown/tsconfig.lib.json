{
  "extends": "@liry-a/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.lib.tsbuildinfo",
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "scripts", "eslint.config.ts", "tsdown.config.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
